{
  "shortcut": "cmd-t",
  "commands": [
    { "id": "claude", "label": "Claude", "command": "claude" },
    { "id": "claude-work", "label": "Claude (work)", "command": "CLAUDE_CONFIG_DIR=$HOME/.claude-work claude" },
    { "id": "codex", "label": "Codex", "command": "codex", "askSpace": false },
    { "id": "zed", "label": "Open in Zed", "command": "zed ." },
    { "id": "vscode", "label": "Open in VS Code", "command": "code ." }
  ],
  "spaces": [
    {
      "id": "web", "label": "web", "path": "~/code/web",
      "commands": [
        { "id": "dev", "label": "Dev server", "command": "pnpm dev" },
        { "id": "test", "label": "Run tests", "command": "pnpm test --watch" }
      ]
    },
    { "path": "~/code/api", "commands": [{ "command": "pnpm dev --port 3001" }] }
  ],
  "quickActions": [
    { "command": "claude", "label": "New Claude tab" },
    { "builtin": "new-tab" },
    { "builtin": "new-space" },
    { "command": "web/test" },
    { "space": "api" }
  ]
}
